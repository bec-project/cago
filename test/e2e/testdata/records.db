record(longout, "$(P)Long") {
    field(VAL, "42")
}
record(ao, "$(P)Double") {
    field(VAL, "1.25")
    field(EGU, "mm")
    field(PREC, "3")
    field(HOPR, "10")
    field(LOPR, "-10")
    field(DRVH, "9")
    field(DRVL, "-9")
    field(HIHI, "8")
    field(HHSV, "MAJOR")
    field(HIGH, "7")
    field(HSV, "MINOR")
    field(LOW, "-7")
    field(LSV, "MINOR")
    field(LOLO, "-8")
    field(LLSV, "MAJOR")
}
record(stringout, "$(P)Text") {
    field(VAL, "ready")
}
record(stringin, "$(P)Message") {
    field(DESC, "Operator message")
    field(VAL, "User Operation 400mA top-up")
    field(PINI, "YES")
}
record(mbbo, "$(P)Enum") {
    field(ZRST, "OFF")
    field(ONST, "ON")
    field(VAL, "1")
}
record(waveform, "$(P)DoubleArray") {
    field(FTVL, "DOUBLE")
    field(NELM, "70000")
}
record(waveform, "$(P)ShortArray") {
    field(FTVL, "SHORT")
    field(NELM, "8")
}
record(waveform, "$(P)FloatArray") {
    field(FTVL, "FLOAT")
    field(NELM, "8")
}
record(waveform, "$(P)CharArray") {
    field(FTVL, "CHAR")
    field(NELM, "8")
}
